#!/bin/bash
set -euo pipefail
scale=${LUMINA_RENDER_SCALE:-2}
apply() {
  local connector output preferred width height
  for connector in /sys/class/drm/card*-*; do
    [[ $(<"$connector/status") == connected ]] || continue
    preferred=$(head -1 "$connector/modes")
    [[ -n $preferred ]] || continue
    output=${connector##*/}
    output=${output#*-}
    width=$(awk -v n="${preferred%x*}" -v s="$scale" 'BEGIN { printf "%d", n * s / 2 + 0.5 }')
    height=$(awk -v n="${preferred#*x}" -v s="$scale" 'BEGIN { printf "%d", n * s / 2 + 0.5 }')
    hyprctl eval "hl.monitor({ output = \"$output\", mode = \"${width}x${height}@60\", position = \"auto\", scale = $scale })" >/dev/null
  done
}
apply
udevadm monitor --udev --subsystem-match=drm | while IFS= read -r line; do
  [[ $line == *change* ]] || continue
  while IFS= read -r -t 0.3 _; do :; done
  apply
done
